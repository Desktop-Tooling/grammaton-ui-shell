name "actor-shell-workspace"
description "Non-frustrating UI shell workspace"
authors "AMDphreak"
license "MIT"
subPackage "./packages/libbeam_d"
subPackage "./packages/libglaze_2d"
subPackage "./packages/libshell_bridge"
subPackage "./packages/actor_shell"
dependency "actor_shell" path="./packages/actor_shell"
targetType "executable"
targetName "actor-shell"
targetPath "bin"
sourcePaths "packages/actor_shell/source"
importPaths "packages/actor_shell/source" "packages/libbeam_d/source"
dependency "libbeam_d" path="./packages/libbeam_d"
